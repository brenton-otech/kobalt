cmake_minimum_required(VERSION 3.22)
if(NOT IS_ABSOLUTE "${BUILD}" OR NOT IS_ABSOLUTE "${SDK}")
    message(FATAL_ERROR "BUILD and SDK must be absolute paths")
endif()
set(stage "${BUILD}/package")
set(app "${stage}/kobalt")
if(NOT EXISTS "${app}/bin/kobalt" OR NOT EXISTS "${app}/plugins/platforms/libqkindle.so")
    message(FATAL_ERROR "Install the Kindle app and platform plugin before packaging")
endif()
file(MAKE_DIRECTORY "${app}/lib" "${app}/plugins" "${app}/launcher" "${stage}/extensions/kobalt")
# Dereference shared-library symlinks: Kindle USB storage does not support them.
file(GLOB qt_libraries "${SDK}/qt/lib/libQt6*.so.6")
foreach(library IN LISTS qt_libraries)
    get_filename_component(name "${library}" NAME)
    file(REAL_PATH "${library}" actual)
    configure_file("${actual}" "${app}/lib/${name}" COPYONLY)
endforeach()
# Use the compiler that configured this application, including its own runtime.
# Never select a different ABI by guessing a toolchain path in the SDK.
include("${BUILD}/package-sdk.cmake")
if(NOT IS_ABSOLUTE "${compiler}" OR NOT EXISTS "${compiler}")
    message(FATAL_ERROR "Missing configured target compiler: ${compiler}")
endif()
if(NOT target MATCHES "^(pw5|pw3|colorsoft)$")
    message(FATAL_ERROR "Missing or unsupported configured Kindle target: ${target}")
endif()
foreach(name libstdc++.so.6 libgcc_s.so.1 libatomic.so.1)
    execute_process(COMMAND "${compiler}" "-print-file-name=${name}" OUTPUT_VARIABLE library
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT IS_ABSOLUTE "${library}" OR NOT EXISTS "${library}")
        message(FATAL_ERROR "Missing target runtime ${name}: ${library}")
    endif()
    file(REAL_PATH "${library}" actual)
    configure_file("${actual}" "${app}/lib/${name}" COPYONLY)
endforeach()
file(REAL_PATH "${SDK}/runtime/lib/libz.so.1" zlib)
if(NOT EXISTS "${zlib}")
    message(FATAL_ERROR "Missing SDK zlib runtime")
endif()
configure_file("${zlib}" "${app}/lib/libz.so.1" COPYONLY)
if(NOT EXISTS "${SDK}/qt/plugins/sqldrivers/libqsqlite.so")
    message(FATAL_ERROR "Prepare the Kindle SDK with the Qt SQLite driver")
endif()
foreach(name libssl.so.3 libcrypto.so.3)
    file(REAL_PATH "${SDK}/openssl/lib/${name}" actual)
    if(NOT EXISTS "${actual}")
        message(FATAL_ERROR "Prepare the Kindle SDK with OpenSSL: missing ${name}")
    endif()
    configure_file("${actual}" "${app}/lib/${name}" COPYONLY)
endforeach()
if(NOT EXISTS "${SDK}/qt/plugins/tls/libqopensslbackend.so")
    message(FATAL_ERROR "Prepare the Kindle SDK with Qt's OpenSSL backend")
endif()
foreach(directory imageformats sqldrivers tls)
    if(EXISTS "${SDK}/qt/plugins/${directory}")
        file(COPY "${SDK}/qt/plugins/${directory}" DESTINATION "${app}/plugins")
    endif()
endforeach()
foreach(name launch.sh supervisor.sh check-storage.sh check-runtime.sh)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/launcher/${name}" "${app}/launcher/${name}" COPYONLY)
endforeach()
file(WRITE "${app}/launcher/runtime-target" "${target}\n")
foreach(name config.xml menu.json)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/launcher/${name}" "${stage}/extensions/kobalt/${name}" COPYONLY)
endforeach()
file(WRITE "${app}/bin/qt.conf" "[Paths]\nPrefix=..\nLibraries=lib\nPlugins=plugins\n")
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
file(MAKE_DIRECTORY "${app}/licenses")
configure_file("${root}/LICENSE" "${app}/licenses/Kobalt-MIT.txt" COPYONLY)
if(EXISTS "${SDK}/src/openssl-3.5.9/LICENSE.txt")
    set(openssl_source "${SDK}/src/openssl-3.5.9")
else()
    set(openssl_source "${SDK}/src/openssl-openssl-3.5.9")
endif()
configure_file("${openssl_source}/LICENSE.txt" "${app}/licenses/OpenSSL-Apache-2.0.txt" COPYONLY)
file(COPY "${root}/assets/notices/" DESTINATION "${app}/licenses/dependencies")
foreach(module qtbase qtsensors)
    file(COPY "${SDK}/src/${module}-everywhere-src-6.8.3/LICENSES/" DESTINATION "${app}/licenses/${module}")
endforeach()
# Remove retired runtime files from an incremental package stage.
file(GLOB retired_fbink "${app}/lib/libfbink.so*")
file(REMOVE ${retired_fbink} "${app}/licenses/FBInk-GPL.txt")
if(target STREQUAL pw3 OR target STREQUAL colorsoft)
    set(package "Kobalt-kindle-${target}-prototype.zip")
else()
    set(package "Kobalt-kindle-prototype.zip")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${BUILD}/${package}" --format=zip kobalt extensions
    WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Kindle ${target} prototype: ${BUILD}/${package}")
# The Colorsoft's current jailbreak installs apps with KPM, not KUAL. A KPM
# package is a gzip tar with manifest.json and optional sh hooks at its root;
# the hooks share the staged app rather than copying it again.
if(target STREQUAL colorsoft)
    file(READ "${app}/assets/manifest.json" assets)
    string(JSON kobalt_version GET "${assets}" version)
    # KPM versions are three integers; a prerelease suffix has no field.
    if(NOT kobalt_version MATCHES "^v?([0-9]+)\\.([0-9]+)(\\.([0-9]+))?")
        message(FATAL_ERROR "Cannot derive a KPM version from ${kobalt_version}")
    endif()
    set(version_major "${CMAKE_MATCH_1}")
    set(version_minor "${CMAKE_MATCH_2}")
    set(version_patch "${CMAKE_MATCH_4}")
    if(version_patch STREQUAL "")
        set(version_patch 0)
    endif()
    set(description "Kobalt ${kobalt_version} prototype for the Kindle Colorsoft: a DRM-free EPUB reader")
    configure_file("${CMAKE_CURRENT_LIST_DIR}/kpm/manifest.json.in" "${stage}/manifest.json" @ONLY)
    foreach(name install.sh uninstall.sh launch.sh)
        configure_file("${CMAKE_CURRENT_LIST_DIR}/kpm/${name}" "${stage}/${name}" COPYONLY)
    endforeach()
    configure_file("${CMAKE_CURRENT_LIST_DIR}/kpm/Kobalt.sh" "${stage}/scriptlets/Kobalt.sh" COPYONLY)
    set(kpm_package "Kobalt-kindle-${target}-prototype.kpkg")
    # manifest.json comes first so KPM finds it without reading the whole archive.
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${BUILD}/${kpm_package}"
        manifest.json install.sh uninstall.sh launch.sh scriptlets kobalt
        WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
    message(STATUS "Kindle ${target} KPM package: ${BUILD}/${kpm_package}")
endif()
