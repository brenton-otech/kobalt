include("${CMAKE_CURRENT_LIST_DIR}/build-identity.cmake")
kobalt_kindle_identity(v1.0-beta.7 pw5 1)
if(NOT KOBALT_KINDLE_ARTIFACT STREQUAL "Kobalt-1.0-beta.7-kindle-pw5-r1" OR
   NOT KOBALT_KINDLE_PACKAGE_REVISION EQUAL 207001)
    message(FATAL_ERROR "Unexpected beta.7 build identity")
endif()
set(previous 0)
foreach(version v1.0-alpha.1 v1.0-beta.6 v1.0-beta.7 v1.0-RC.1 v1.0 v1.0.1-alpha.1)
    kobalt_kindle_identity("${version}" colorsoft 1)
    if(NOT KOBALT_KINDLE_PACKAGE_REVISION GREATER previous)
        message(FATAL_ERROR "Package version did not increase for ${version}")
    endif()
    set(previous "${KOBALT_KINDLE_PACKAGE_REVISION}")
endforeach()
kobalt_kindle_identity(v1.0-beta.7 pw3 2)
if(NOT KOBALT_KINDLE_PACKAGE_REVISION EQUAL 207002)
    message(FATAL_ERROR "Kindle revision was lost")
endif()
message(STATUS "Kindle build identity checks passed")
