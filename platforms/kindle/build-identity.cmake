# Keep application/profile identity stable; distinguish only the displayed build
# and distribution artifact. Pin the exact upstream base, including main builds.
set(KOBALT_KINDLE_UPSTREAM_COMMIT 679175046d8c806ea3b404525180fbc29a26fcd2)
function(kobalt_kindle_identity version target revision)
    if(NOT target MATCHES "^(pw5|pw3|colorsoft)$" OR NOT revision MATCHES "^[1-9][0-9]*$" OR revision GREATER 999)
        message(FATAL_ERROR "Expected Kindle target and revision in 1..999")
    endif()
    if(NOT version MATCHES "^v?([0-9]+)\\.([0-9]+)(\\.([0-9]+))?(-(alpha|beta|RC)\\.([0-9]+))?$")
        message(FATAL_ERROR "Unsupported upstream version: ${version}")
    endif()
    set(major "${CMAKE_MATCH_1}")
    set(minor "${CMAKE_MATCH_2}")
    set(patch "${CMAKE_MATCH_4}")
    set(stage "${CMAKE_MATCH_6}")
    set(prerelease "${CMAKE_MATCH_7}")
    if(patch STREQUAL "")
        set(patch 0)
    endif()
    set(channel 900000)
    if(stage)
        if(prerelease GREATER 99)
            message(FATAL_ERROR "Prerelease number must be at most 99")
        endif()
        if(stage STREQUAL alpha)
            set(channel 100000)
        elseif(stage STREQUAL beta)
            set(channel 200000)
        else()
            set(channel 300000)
        endif()
        math(EXPR channel "${channel} + ${prerelease} * 1000")
    endif()
    math(EXPR package_revision "${patch} * 1000000 + ${channel} + ${revision}")
    string(REGEX REPLACE "^v" "" display "${version}")
    set(KOBALT_KINDLE_DISPLAY_VERSION "${display} · unofficial Kindle ${target} build ${revision}" PARENT_SCOPE)
    set(KOBALT_KINDLE_ARTIFACT "Kobalt-${display}-kindle-${target}-r${revision}" PARENT_SCOPE)
    set(KOBALT_KINDLE_VERSION_MAJOR "${major}" PARENT_SCOPE)
    set(KOBALT_KINDLE_VERSION_MINOR "${minor}" PARENT_SCOPE)
    set(KOBALT_KINDLE_PACKAGE_REVISION "${package_revision}" PARENT_SCOPE)
endfunction()
